// T05/T06 — foundation schema. NO domain tables (blocked by Gate 0).
// Time model (G1): timestamptz for instants, @db.Date for business calendar dates.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["iam", "audit", "common", "authz", "org", "cemetery", "files", "contracts", "services"]
}

model User {
  id           String   @id
  email        String   @unique
  passwordHash String   @map("password_hash")

  /// Họ tên và CHỨC DANH HÀNH CHÍNH ("PHÓ GIÁM ĐỐC") — thêm 05/09/2026 cùng luật "người ký
  /// thẻ mộ là người quản lý nghĩa trang". Toàn hệ không có bảng nhân sự nào, và đây là
  /// "danh sách nhân viên" nhỏ nhất chạy được: hai cột, không phải một module.
  ///
  /// `title` KHÔNG thay được bằng mã vai. Vai (`QL_NGHIA_TRANG`) là quyền kỹ thuật; chức danh
  /// là thứ in lên tờ giấy. Không suy được cái này từ cái kia.
  ///
  /// Cả hai NULLABLE: ghế máy `system-worker@erp.local` không có chức danh nào cả, và bắt
  /// NOT NULL là phải bịa dữ liệu cho những tài khoản đã có. Tính bắt buộc ép ở chỗ TẠO
  /// NGƯỜI KÝ, không ép lên mọi tài khoản của hệ.
  fullName     String?  @map("full_name")
  title        String?
  status       String   @default("active")
  mfaEnabled   Boolean  @default(false) @map("mfa_enabled")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  sessions Session[]

  @@map("users")
  @@schema("iam")
}

// Auth session backing refresh-token rotation. currentRefreshJti enforces one-time
// use: a refresh token whose jti != currentRefreshJti is rejected (reuse detection).
model Session {
  id                String    @id
  userId            String    @map("user_id")
  currentRefreshJti String    @map("current_refresh_jti")
  userAgent         String?   @map("user_agent")
  ipAddress         String?   @map("ip_address")
  expiresAt         DateTime  @map("expires_at") @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  revokedAt         DateTime? @map("revoked_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("sessions")
  @@schema("iam")
}

// Append-only audit trail (doc 10 §3). UPDATE/DELETE are blocked by a DB trigger
// added in the initial migration — enforcement does not rely on the application layer.
model AuditEvent {
  id                    String   @id
  occurredAt            DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)
  chainPartitionDateUtc DateTime @map("chain_partition_date_utc") @db.Date
  companyId             String?  @map("company_id")
  actorType             String   @map("actor_type")
  actorId               String?  @map("actor_id")
  action                String
  entityType            String   @map("entity_type")
  entityId              String   @map("entity_id")
  result                String
  reason                String?
  beforeData            Json?    @map("before_data")
  afterData             Json?    @map("after_data")
  changedFields         String[] @map("changed_fields")
  correlationId         String?  @map("correlation_id")
  ipAddress             String?  @map("ip_address")
  source                String   @default("API")
  previousEventHash     String?  @map("previous_event_hash")
  eventHash             String   @map("event_hash")
  hashAlgorithmVersion  Int      @default(1) @map("hash_algorithm_version")

  @@index([companyId, occurredAt])
  @@index([companyId, chainPartitionDateUtc])
  @@index([entityType, entityId])
  @@index([actorId])
  @@index([action])
  @@map("audit_events")
  @@schema("audit")
}

// Transactional outbox: side effects (email/notification/webhook) are enqueued in the
// same transaction as the business change; a worker (T09) dispatches them at-least-once.
model OutboxEvent {
  id            String    @id
  aggregateType String    @map("aggregate_type")
  aggregateId   String    @map("aggregate_id")
  eventType     String    @map("event_type")
  channel       String
  payload       Json
  dedupKey      String?   @unique @map("dedup_key")
  status        String    @default("PENDING") // PENDING | SENT | DEAD
  attempts      Int       @default(0)
  maxAttempts   Int       @default(10) @map("max_attempts")
  lastError     String?   @map("last_error")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  processedAt   DateTime? @map("processed_at") @db.Timestamptz(6)

  @@index([status, createdAt])
  @@map("outbox_events")
  @@schema("common")
}

// RBAC structure (T08). Permissions are `module.resource.action`. Scope on each grant
// bounds the data a role may act on. NO concrete permission seed yet (Gate 0 / A6).
model Role {
  id          String   @id
  code        String   @unique
  name        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  rolePermissions RolePermission[]
  assignments     RoleAssignment[]

  @@map("roles")
  @@schema("authz")
}

// Assigns a role to a user (optionally scoped to a company). No FK to iam.users to keep
// it simple; userId is the iam.users id.
model RoleAssignment {
  id          String    @id
  userId      String    @map("user_id")
  roleId      String    @map("role_id")
  companyId   String?   @map("company_id")
  scope       String? // optional scope override for this assignment
  validFrom   DateTime  @default(now()) @map("valid_from") @db.Timestamptz(6)
  /// null = vô thời hạn. Có giá trị = quyền TỰ RỤNG, không cần ai nhớ đi thu hồi.
  validTo     DateTime? @map("valid_to") @db.Timestamptz(6)
  grantedBy   String?   @map("granted_by")
  grantReason String?   @map("grant_reason")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  role Role @relation(fields: [roleId], references: [id])

  @@unique([userId, roleId, companyId])
  @@index([userId])
  @@map("role_assignments")
  @@schema("authz")
}

/**
 * Luật truy cập có THỨ TỰ — mô hình tường lửa.
 * Duyệt từ `priority` nhỏ đến lớn; luật nào KHỚP TRƯỚC thì luật đó quyết, và dừng.
 * Không luật nào khớp thì rơi xuống ma trận vai. Không grant nào phủ thì 403 — đó là
 * "deny all" ngầm ở cuối chuỗi, do PermissionGuard mặc-định-từ-chối đảm nhiệm.
 * Hệ quả phải biết: một luật ALLOW nằm TRÊN ma trận vai. Nó cấp được thứ không vai nào
 * cấp, kể cả leaf S3 mà grant wildcard không với tới. Đó là bản chất của mô hình tường
 * lửa, không phải lỗi — nên `reason` là bắt buộc và thứ tự phải đọc được
 * (scripts/authz-rules.ts in ra đúng chuỗi luật theo thứ tự duyệt).
 * `subjectUserId = null` + `roleCode = null` = áp cho mọi người.
 */
model AccessRule {
  id             String    @id
  /// Nhỏ hơn xét trước. Bằng nhau thì xét theo createdAt để thứ tự luôn xác định.
  priority       Int
  /// ALLOW | DENY
  effect         String
  subjectUserId  String?   @map("subject_user_id")
  roleCode       String?   @map("role_code")
  /// Mẫu mã quyền, 3 đoạn, cho phép '*' (ví dụ `crm.person.*`).
  permissionCode String    @map("permission_code")
  reason         String
  createdBy      String?   @map("created_by")
  validFrom      DateTime  @default(now()) @map("valid_from") @db.Timestamptz(6)
  validTo        DateTime? @map("valid_to") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([priority])
  @@index([subjectUserId])
  @@index([permissionCode])
  @@map("access_rules")
  @@schema("authz")
}

// Catalog rows are seeded from src/modules/authorization/permission-catalog.ts.
// sensitivity/wildcardExempt are ADMIN metadata: they bound who may be granted the
// leaf and whether a `*` grant may reach it — they are not used for runtime matching.
model Permission {
  id             String    @id
  code           String    @unique // module.resource.action
  description    String?
  sensitivity    String    @default("S1") // S0 | S1 | S2 | S3 (doc 16 §D.4)
  wildcardExempt Boolean   @default(false) @map("wildcard_exempt") // S3: `*` không trùm
  introducedIn   String?   @map("introduced_in") // bản phát hành sinh ra mã (nhãn "New")
  reviewedAt     DateTime? @map("reviewed_at") @db.Timestamptz(6) // null = chưa ai rà

  rolePermissions RolePermission[]

  @@map("permissions")
  @@schema("authz")
}

model RolePermission {
  id           String @id
  roleId       String @map("role_id")
  permissionId String @map("permission_id")
  scope        String @default("DEPARTMENT") // SELF|ASSIGNED|DEPARTMENT|COMPANY|GROUP|CUSTOM

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@unique([roleId, permissionId])
  @@map("role_permissions")
  @@schema("authz")
}

// Named CUSTOM scope definitions referenced by grants with scope = CUSTOM.
/**
 * Which cemeteries a person covers — the "hub" axis, kept deliberately separate from
 * which role they hold (blueprint doc 16 §B.1, §D.10).
 * Many-to-many by decision: one cemetery has several people, and one person may cover
 * several cemeteries that are nowhere near each other. That is why this is its own table
 * and not a `cemetery_id` column on the role assignment — a column can only ever express
 * one site per role, and would have had to be undone later.
 * Holding a role grants nothing here. A SITE-scoped grant reaches a record only when the
 * record's cemetery is ALSO in this table for that user: effective access is the
 * INTERSECTION of the two axes, never their sum.
 */
model ScopeAssignment {
  id         String    @id
  userId     String    @map("user_id")
  cemeteryId String    @map("cemetery_id")
  grantedBy  String?   @map("granted_by")
  validFrom  DateTime  @default(now()) @map("valid_from") @db.Timestamptz(6)
  validTo    DateTime? @map("valid_to") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([userId, cemeteryId])
  @@index([userId])
  @@index([cemeteryId])
  @@map("scope_assignments")
  @@schema("authz")
}

model ScopePolicy {
  id          String  @id
  code        String  @unique
  description String?
  rule        Json

  @@map("scope_policies")
  @@schema("authz")
}

// ---- M0: organization (minimal) + cemetery catalog ----

// Minimal company. Full org tree (departments/positions/assignments) is a later task.
model Company {
  id        String   @id
  code      String   @unique
  name      String
  status    String   @default("active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("companies")
  @@schema("org")
}

model Cemetery {
  id        String   @id
  companyId String   @map("company_id")
  code      String
  name      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  gravePlots GravePlot[]

  @@unique([companyId, code])
  @@index([companyId])
  @@map("cemeteries")
  @@schema("cemetery")
}

// G0-A1: capacity defaults by type; a plot may override with audit.
model GraveType {
  id              String   @id
  companyId       String   @map("company_id")
  code            String
  name            String
  defaultCapacity Int      @default(1) @map("default_capacity")
  referencePrice  Decimal? @map("reference_price") @db.Decimal(14, 0) // VND (integer đồng)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  gravePlots GravePlot[]

  @@unique([companyId, code])
  @@map("grave_types")
  @@schema("cemetery")
}

model GravePlot {
  id          String @id
  companyId   String @map("company_id")
  cemeteryId  String @map("cemetery_id")
  graveTypeId String @map("grave_type_id")
  plotCode    String @map("plot_code")

  // Denormalized location tree (khu / phân khu / lô / dãy).
  zone    String?
  subzone String?
  block   String?
  row     String?

  /**
   * Toạ độ để vẽ sơ đồ mặt bằng khu mộ (in ở mặt trong thẻ quản lý mộ).
   * Hệ TOẠ ĐỘ CỤC BỘ theo từng nghĩa trang, đơn vị mét, gốc ở góc do người vẽ chọn —
   * KHÔNG phải kinh/vĩ độ. Lý do: sơ đồ nghĩa trang là bản vẽ mặt bằng, cần chính xác
   * tương đối giữa các mộ chứ không cần định vị trên bản đồ trái đất; và nhập được bằng
   * thước từ bản vẽ có sẵn, không cần đo GPS từng ngôi.
   * Cho phép NULL: mộ chưa số hoá vị trí vẫn dùng bình thường, chỉ không hiện trên sơ đồ.
   */
  mapX Float? @map("map_x")
  mapY Float? @map("map_y")

  capacityOverride Int?     @map("capacity_override") // null => use grave type default (G0-A1)
  status           String   @default("Available") // Available|Held|Reserved|Allocated|Occupied|Maintenance|Locked
  version          Int      @default(0) // optimistic lock for hold/allocation later
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  cemetery      Cemetery                 @relation(fields: [cemeteryId], references: [id])
  graveType     GraveType                @relation(fields: [graveTypeId], references: [id])
  statusHistory GravePlotStatusHistory[]
  holds         GraveHold[]
  tags          GravePlotTag[]

  @@unique([companyId, plotCode])
  @@index([companyId, status])
  @@index([cemeteryId])
  @@map("grave_plots")
  @@schema("cemetery")
}

/**
 * DANH MỤC THẺ NHÃN CHO PHẦN MỘ — toàn hệ, KHÔNG chia theo công ty.
 *
 * Anh Bách chốt 03/09/2026: hai danh mục TÁCH RIÊNG (thẻ mộ và thẻ khách), nhưng cả hai
 * đều dùng chung cho MỌI công ty. "Cần sửa bia" là cùng một ý ở mọi nghĩa trang, nên khai
 * lại nó cho từng công ty là việc thừa.
 *
 * VÌ SAO TÁCH HAI BẢNG, chứ không một bảng có cột "thẻ này dùng cho mộ hay cho khách":
 * tách làm cho ranh giới đạo đức thành ranh giới CẤU TRÚC. Một thẻ nói về con người không
 * thể lỡ tay gắn lên mộ, và ngược lại — không phải vì có một cột kiểm đúng hay một câu `if`
 * trong service, mà vì khoá ngoại không nối tới được. Đã đo bằng psql: gắn một thẻ khách
 * lên bảng thẻ mộ bị khoá ngoại từ chối.
 *
 * Thẻ mộ nói về một VẬT, nên nó KHÔNG có cột `subject` như bên khách. Không có gì phải rào:
 * "bia nứt", "nền lún" không thể trở thành một nhận định về ai.
 */
model GravePlotTagType {
  id          String  @id
  code        String  @unique
  name        String
  description String?

  /// Active | Retired. NGỪNG DÙNG chứ không xoá: thẻ đã gắn vẫn phải đọc được tên.
  status String @default("Active")

  createdBy String?  @map("created_by")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tags GravePlotTag[]

  @@index([status])
  @@map("grave_plot_tag_types")
  @@schema("cemetery")
}

/**
 * DANH MỤC THẺ NHÃN CHO KHÁCH HÀNG — toàn hệ, KHÔNG chia theo công ty.
 *
 * Khác danh mục thẻ mộ đúng MỘT cột, và cột đó là lý do thứ hai để hai bảng phải tách:
 * `subject`. Mỗi thẻ khách bắt buộc khai nó nói về HỒ SƠ hay về GIAO DỊCH — danh sách ĐÓNG,
 * CHECK ở migration.
 *
 * VÌ SAO: thẻ gắn lên mộ nói về một vật; thẻ gắn lên khách nói về một CON NGƯỜI, mà gia
 * đình họ vừa có người mất. Một thẻ kiểu "khách khó tính" hay "khả năng chi trả thấp" gán
 * một PHẨM CHẤT cho người — không ngày kết thúc, không ai xác minh, không ai gỡ. Cột này
 * chặn nó NGAY Ở CSDL: một thẻ nói về tính cách KHÔNG CÓ GIÁ TRỊ NÀO ĐỂ KHAI.
 *
 * Thêm nữa: tôn giáo, dân tộc, sức khoẻ là dữ liệu cá nhân NHẠY CẢM theo NĐ 13/2023, và hệ
 * đã che ba trường đó ở mức S3. Một bảng thẻ tự do sẽ là cửa sau vòng qua đúng lớp che ấy.
 *
 * THƯỚC ĐO cho mọi thẻ khách: phải chịu được việc ĐỌC TO TRƯỚC MẶT CHÍNH KHÁCH.
 */
model CustomerTagType {
  id          String  @id
  code        String  @unique
  name        String
  description String?

  /// HO_SO | GIAO_DICH — danh sách ĐÓNG, CHECK ở migration. Xem khối chú thích trên.
  subject String

  status String @default("Active")

  createdBy String?  @map("created_by")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tags CustomerTag[]

  @@index([status, subject])
  @@map("customer_tag_types")
  @@schema("cemetery")
}

/**
 * THẺ ĐANG GẮN TRÊN MỘT PHẦN MỘ.
 *
 * Gỡ thẻ là GHI `removedAt`, không xoá dòng — anh Bách chốt "lưu vết". `#can-sua-bia` gỡ ra
 * rồi thì vẫn phải trả lời được "bia này đã sửa chưa, ai xác nhận, ngày nào".
 *
 * Một mộ không mang HAI thẻ cùng loại cùng lúc — partial unique index `WHERE removed_at IS
 * NULL`, không phải `@@unique` thường: gắn lại thẻ đã từng gỡ là việc bình thường.
 */
model GravePlotTag {
  id          String @id
  gravePlotId String @map("grave_plot_id")
  tagTypeId   String @map("tag_type_id")

  assignedBy String?  @map("assigned_by")
  assignedAt DateTime @default(now()) @map("assigned_at") @db.Timestamptz(6)

  removedBy String?   @map("removed_by")
  removedAt DateTime? @map("removed_at") @db.Timestamptz(6)
  /// Vì sao gỡ. Chữ tự do CHỈ ĐỂ ĐỌC LẠI, không lọc theo nó.
  removeReason String? @map("remove_reason")

  gravePlot GravePlot        @relation(fields: [gravePlotId], references: [id])
  tagType   GravePlotTagType @relation(fields: [tagTypeId], references: [id])

  @@index([gravePlotId, removedAt])
  @@index([tagTypeId])
  @@map("grave_plot_tags")
  @@schema("cemetery")
}

/**
 * THẺ ĐANG GẮN TRÊN MỘT KHÁCH HÀNG.
 *
 * Cùng hình dạng với thẻ mộ, nhưng ở đây lưu vết KHÔNG chỉ tiện cho nghiệp vụ — nó là NGHĨA
 * VỤ. NĐ 13/2023 cho chủ thể dữ liệu quyền biết dữ liệu của mình được xử lý thế nào; "ai đã
 * gắn nhãn này lên tôi, ngày nào, ai gỡ" phải trả lời được.
 */
model CustomerTag {
  id         String @id
  customerId String @map("customer_id")
  tagTypeId  String @map("tag_type_id")

  assignedBy String?  @map("assigned_by")
  assignedAt DateTime @default(now()) @map("assigned_at") @db.Timestamptz(6)

  removedBy    String?   @map("removed_by")
  removedAt    DateTime? @map("removed_at") @db.Timestamptz(6)
  removeReason String?   @map("remove_reason")

  customer Customer        @relation(fields: [customerId], references: [id])
  tagType  CustomerTagType @relation(fields: [tagTypeId], references: [id])

  @@index([customerId, removedAt])
  @@index([tagTypeId])
  @@map("customer_tags")
  @@schema("cemetery")
}

model GravePlotStatusHistory {
  id          String   @id
  gravePlotId String   @map("grave_plot_id")
  fromStatus  String?  @map("from_status")
  toStatus    String   @map("to_status")
  reason      String?
  changedBy   String?  @map("changed_by")
  changedAt   DateTime @default(now()) @map("changed_at") @db.Timestamptz(6)

  gravePlot GravePlot @relation(fields: [gravePlotId], references: [id])

  @@index([gravePlotId, changedAt])
  @@map("grave_plot_status_history")
  @@schema("cemetery")
}

// Family relationship catalog with reciprocal mapping (spouse<->spouse, parent<->child, sibling<->sibling).
model RelationshipType {
  code           String  @id // SPOUSE | PARENT | CHILD | SIBLING
  name           String
  reciprocalCode String  @map("reciprocal_code")
  genderSpecific Boolean @default(false) @map("gender_specific")

  @@map("relationship_types")
  @@schema("cemetery")
}

// ---- M1: Person / Customer master + family graph ----

// Shared across companies (G0-E5.1). CCCD: encrypted (viewable w/ permission) + hashed
// for dedup + masked for display (G0-E5.2, G0-A6). No companyId on Person (shared).
model Person {
  id               String    @id
  fullName         String    @map("full_name")
  gender           String? // MALE | FEMALE | UNKNOWN
  dateOfBirth      DateTime? @map("date_of_birth") @db.Date
  nationalIdHash   String?   @map("national_id_hash") // sha256 for dedup
  nationalIdMasked String?   @map("national_id_masked") // e.g. 079***123 for display
  nationalIdCipher String?   @map("national_id_cipher") // iv:tag:ciphertext (AES-256-GCM)

  /**
   * Nơi/ngày cấp CCCD. Đi liền với số CCCD nên cùng mức bảo vệ S3: biết "cấp ngày X tại
   * tỉnh Y" là đã thu hẹp đáng kể việc dò ra số.
   */
  nationalIdIssuedOn    DateTime? @map("national_id_issued_on") @db.Date
  nationalIdIssuedPlace String?   @map("national_id_issued_place")

  /**
   * Liên lạc CHÍNH — thứ ghi trên giấy tờ. Trước đây chỉ Customer mới có, nhưng người
   * được an táng và thân nhân không phải ai cũng có bản ghi Customer mà vẫn cần liên hệ.
   * Bốn cột này KHÔNG trùng lặp với `phones`/`addresses` bên dưới, chúng khác nghĩa:
   * ở đây là "số/địa chỉ chính thức", bảng con là "các số/địa chỉ KHÁC". Vì khác nghĩa
   * nên không cần đồng bộ hai chiều — chỗ hay hỏng nhất của mô hình có cột đệm.
   */
  phone            String?
  email            String?
  permanentAddress String? @map("permanent_address")
  contactAddress   String? @map("contact_address")

  /**
   * Nơi sinh. NĐ 13/2023 Điều 2.3 xếp vào dữ liệu cá nhân CƠ BẢN (không phải nhóm nhạy
   * cảm Điều 2.4), nên che cùng mức với địa chỉ và ngày sinh — `crm.person.view_contact`,
   * không phải `view_sensitive`. Nghiệp vụ tang lễ cần nó để ghi bia và làm thủ tục.
   */
  placeOfBirth String? @map("place_of_birth")

  /**
   * NĐ 13/2023 Điều 2.4 gọi ĐÍCH DANH nguồn gốc dân tộc và quan điểm tôn giáo là dữ liệu
   * cá nhân NHẠY CẢM — cùng nhóm với CCCD, không phải nhóm liên lạc. Nghiệp vụ tang lễ
   * cần chúng (nghi thức theo tôn giáo, phong tục theo dân tộc), nên lưu; nhưng che ở mức
   * S3 và chỉ mở cho vai giữ hồ sơ nhân thân.
   */
  ethnicity String?
  religion  String?

  status    String   @default("active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  customer          Customer?
  deceased          DeceasedPerson?
  relationshipsFrom FamilyRelationship[] @relation("relSource")
  relationshipsTo   FamilyRelationship[] @relation("relTarget")
  phones            PersonPhone[]
  addresses         PersonAddress[]
  education         PersonEducation[]
  bankAccounts      PersonBankAccount[]

  @@index([nationalIdHash])
  @@index([fullName])
  @@map("persons")
  @@schema("cemetery")
}

/**
 * ---- Bảng phụ nhân thân (2026-08-26) ----
 * Bốn bảng dưới đây là "các mục KHÁC" ngoài mục chính đã nằm trên `Person`. Chúng dùng
 * chung một hình dạng: khoá ngoại về Person, một nhãn phân loại, cờ `isPrimary`, và
 * `status` để NGỪNG DÙNG thay vì xoá — dữ liệu nhân thân đã từng đúng thì vẫn phải đọc
 * lại được khi đối chiếu hồ sơ cũ.
 */

model PersonPhone {
  id        String   @id
  personId  String   @map("person_id")
  phone     String
  /// MOBILE | HOME | WORK | RELATIVE — nhãn tự do, không ép danh mục đóng.
  kind      String?
  isPrimary Boolean  @default(false) @map("is_primary")
  status    String   @default("active")
  notes     String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  person Person @relation(fields: [personId], references: [id])

  @@index([personId])
  @@map("person_phones")
  @@schema("cemetery")
}

model PersonAddress {
  id        String   @id
  personId  String   @map("person_id")
  address   String
  /// TEMPORARY | WORK | HOMETOWN | OTHER. Thường trú và liên hệ nằm thẳng trên Person.
  kind      String?
  isPrimary Boolean  @default(false) @map("is_primary")
  status    String   @default("active")
  notes     String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  person Person @relation(fields: [personId], references: [id])

  @@index([personId])
  @@map("person_addresses")
  @@schema("cemetery")
}

/**
 * Học vấn: NĐ 13/2023 Điều 2.4 KHÔNG xếp trình độ học vấn vào nhóm nhạy cảm, nên đây là
 * dữ liệu cá nhân thường — bảo vệ bằng quyền ở tầng route (`crm.person.view`), không mask
 * từng trường. Ghi rõ ở đây để lần sau không ai phải đoán lại.
 */
model PersonEducation {
  id             String   @id
  personId       String   @map("person_id")
  school         String?
  major          String?
  degree         String?
  graduationYear Int?     @map("graduation_year")
  status         String   @default("active")
  notes          String?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  person Person @relation(fields: [personId], references: [id])

  @@index([personId])
  @@map("person_education")
  @@schema("cemetery")
}

/**
 * Tài khoản ngân hàng: rủi ro TÀI CHÍNH, khác rủi ro ĐỊNH DANH của CCCD — nên mở bằng mã
 * riêng `crm.person.view_financial`, không dùng chung `view_sensitive`. Hiện CHƯA vai
 * nghiệp vụ nào được cấp mã đó: nghĩa trang chưa có nghiệp vụ chi trả cho thân nhân.
 */
model PersonBankAccount {
  id            String   @id
  personId      String   @map("person_id")
  bankCode      String   @map("bank_code")
  accountNumber String   @map("account_number")
  accountHolder String?  @map("account_holder")
  isPrimary     Boolean  @default(false) @map("is_primary")
  status        String   @default("active")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  person Person @relation(fields: [personId], references: [id])

  @@index([personId])
  @@map("person_bank_accounts")
  @@schema("cemetery")
}

model Customer {
  id           String   @id
  personId     String?  @unique @map("person_id") // individuals link to a Person; org customers null
  customerCode String   @unique @map("customer_code")
  type         String // INDIVIDUAL | ORGANIZATION | AGENT | PROSPECT
  orgName      String?  @map("org_name")
  phone        String?
  email        String?
  status       String   @default("active")
  companyId    String?  @map("company_id") // managing company (scope), nullable
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  person Person?      @relation(fields: [personId], references: [id])
  holds  GraveHold[]
  tags   CustomerTag[]

  @@index([phone])
  @@index([email])
  @@index([companyId])
  @@map("customers")
  @@schema("cemetery")
}

// Direct family relationships only. Creating A->B auto-creates the reciprocal B->A in the
// same transaction; the two rows link via reciprocalRelationshipId (blueprint doc 04 §2.1).
model FamilyRelationship {
  id                       String    @id
  sourcePersonId           String    @map("source_person_id")
  targetPersonId           String    @map("target_person_id")
  relationshipType         String    @map("relationship_type") // relationship_types.code
  reciprocalRelationshipId String?   @unique @map("reciprocal_relationship_id")
  status                   String    @default("Confirmed") // Pending | Confirmed | Disputed | Ended
  effectiveFrom            DateTime? @map("effective_from") @db.Date
  effectiveTo              DateTime? @map("effective_to") @db.Date
  verificationSource       String?   @map("verification_source")
  createdAt                DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  source Person @relation("relSource", fields: [sourcePersonId], references: [id])
  target Person @relation("relTarget", fields: [targetPersonId], references: [id])

  @@index([sourcePersonId])
  @@index([targetPersonId])
  @@map("family_relationships")
  @@schema("cemetery")
}

// M2: grave hold (giữ chỗ). Only one Active hold per plot — enforced by a partial unique
// index added in the migration. Expiry is swept by the worker (T09).
model GraveHold {
  id          String    @id
  gravePlotId String    @map("grave_plot_id")
  customerId  String    @map("customer_id")
  createdBy   String?   @map("created_by")
  status      String    @default("Active") // Active | Expired | Converted | Cancelled
  reason      String?
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  releasedAt  DateTime? @map("released_at") @db.Timestamptz(6)

  gravePlot GravePlot @relation(fields: [gravePlotId], references: [id])
  customer  Customer  @relation(fields: [customerId], references: [id])

  @@index([gravePlotId])
  @@index([status, expiresAt])
  @@map("grave_holds")
  @@schema("cemetery")
}

// M3a: file metadata. Bytes live in MinIO (object storage); DB stores metadata only.
// Sensitivity + scan status gate download; signed URLs are short-lived (doc 06).
model FileObject {
  id           String   @id
  storageKey   String   @unique @map("storage_key")
  originalName String   @map("original_name")
  mimeType     String   @map("mime_type")
  sizeBytes    Int?     @map("size_bytes")
  sensitivity  String   @default("normal") // normal | confidential | restricted
  scanStatus   String   @default("pending") @map("scan_status") // pending | clean | infected
  status       String   @default("pending_upload") // pending_upload | uploaded
  uploadedBy   String?  @map("uploaded_by")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("file_objects")
  @@schema("files")
}

// M3b: external (signed-offline) contract. Allocation happens at Active (G0-G3.1).
// One Active contract per plot — partial unique index in the migration.
model ExternalContract {
  id             String    @id
  companyId      String    @map("company_id")
  contractNo     String    @map("contract_no")
  gravePlotId    String    @map("grave_plot_id")
  contractFileId String?   @map("contract_file_id") // files.file_objects.id
  status         String    @default("Uploaded") // Uploaded|PendingVerification|Verified|Active|Expired|Replaced|Cancelled
  sourceType     String?   @map("source_type")
  signedAt       DateTime? @map("signed_at") @db.Date
  validTo        DateTime? @map("valid_to") @db.Date
  totalAmount    Decimal?  @map("total_amount") @db.Decimal(14, 0) // VND
  /// Ai SOẠN. Cần để chặn "người soạn tự thẩm định hợp đồng của mình".
  createdBy      String?   @map("created_by")
  verifiedBy     String?   @map("verified_by")
  verifiedAt     DateTime? @map("verified_at") @db.Timestamptz(6)
  activatedBy    String?   @map("activated_by")
  activatedAt    DateTime? @map("activated_at") @db.Timestamptz(6)
  version        Int       @default(0)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  parties ContractParty[]

  @@unique([companyId, contractNo])
  @@index([gravePlotId])
  @@index([companyId, status])
  @@map("external_contracts")
  @@schema("contracts")
}

model ContractParty {
  id         String   @id
  contractId String   @map("contract_id")
  customerId String   @map("customer_id")
  role       String // OWNER | SIGNER | CONTACT
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  contract ExternalContract @relation(fields: [contractId], references: [id])

  @@index([contractId])
  @@map("contract_parties")
  @@schema("contracts")
}

// G0-A2 minimal: usage right separate from contract; no transfer workflow yet.
model GraveUsageRight {
  id               String    @id
  gravePlotId      String    @map("grave_plot_id")
  holderCustomerId String    @map("holder_customer_id")
  sourceContractId String    @map("source_contract_id")
  status           String    @default("Active") // Active | Ended | Transferred
  effectiveFrom    DateTime? @map("effective_from") @db.Date
  effectiveTo      DateTime? @map("effective_to") @db.Date

  /**
   * Quyền này sang tên TỪ quyền nào. Nối thành chuỗi để đọc ngược được lịch sử chủ mộ:
   * ai đứng tên trước, sang tên ngày nào, vì sao. Suy từ ngày tháng thì không chắc —
   * hai lần sang tên trong cùng ngày là hết phân biệt được thứ tự.
   */
  previousRightId String? @map("previous_right_id")

  /**
   * Vì sao chấm dứt hoặc sang tên. BẮT BUỘC ở tầng DTO, không phải ở đây: bản ghi cũ
   * không có lý do, và ép NOT NULL là phải bịa lý do cho chúng.
   */
  endedReason String? @map("ended_reason")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([gravePlotId])
  @@index([previousRightId])
  @@index([holderCustomerId])
  @@map("grave_usage_rights")
  @@schema("cemetery")
}

// M4: deceased person (identifies a Person) + burial records.
model DeceasedPerson {
  id              String    @id
  personId        String    @unique @map("person_id")
  dateOfDeath     DateTime? @map("date_of_death") @db.Date
  deathCertFileId String?   @map("death_cert_file_id") // files.file_objects.id (restricted)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  person        Person         @relation(fields: [personId], references: [id])
  burialRecords BurialRecord[]

  @@map("deceased_persons")
  @@schema("cemetery")
}

model BurialRecord {
  id               String  @id
  gravePlotId      String  @map("grave_plot_id")
  deceasedPersonId String  @map("deceased_person_id")
  contractId       String? @map("contract_id")

  /**
   * Ai là chủ mộ, và người được an táng có quan hệ gì với họ — CHỤP LẠI lúc an táng.
   * Không suy ra khi đọc: chủ mộ đổi (kế thừa) hoặc quan hệ bị chấm dứt về sau thì hồ sơ
   * an táng vẫn phải kể đúng căn cứ tại thời điểm đặt cốt. Đây cũng là hai trường in ra
   * thẻ quản lý mộ, nên chúng phải bất biến.
   */
  ownerCustomerId     String? @map("owner_customer_id")
  relationshipToOwner String? @map("relationship_to_owner") // relationship_types.code, hoặc 'SELF'

  /**
   * Cốt số mấy trong phần mộ. Một phần mộ chứa nhiều cốt (sức chứa theo loại mộ), và
   * nghiệp vụ gọi tên từng vị trí — thẻ mộ in "cốt 1", "cốt 2". Đếm số hồ sơ là đủ để
   * chặn vượt sức chứa, nhưng KHÔNG đủ để nói người này nằm ở cốt nào.
   * Cho phép NULL: hồ sơ có trước khi có cột này không mang số cốt, và bịa một số cho
   * chúng là ghi vào hệ một sự thật chưa ai xác nhận.
   * Không trùng cốt trong cùng một mộ — ép bằng partial unique index ở migration, vì
   * ràng buộc chỉ áp cho hồ sơ CÒN HIỆU LỰC (hồ sơ đã huỷ phải nhả cốt ra).
   */
  slotNumber Int? @map("slot_number")

  status         String    @default("Draft") // Draft | Verified | Scheduled | Completed | Cancelled
  burialDate     DateTime? @map("burial_date") @db.Date
  legalDocFileId String?   @map("legal_doc_file_id")
  notes          String?

  /**
   * Vì sao hồ sơ bị huỷ, và lúc nào. Ghi thẳng trên bản ghi chứ không chỉ trong nhật ký
   * kiểm toán: hồ sơ đã huỷ vẫn hiện trên màn hình khách hàng, và một dòng "Đã huỷ" không
   * kèm lý do là chỗ người đọc phải đi hỏi người khác. Cùng nếp với
   * `GraveUsageRight.endedReason`. Huỷ cũng NHẢ CỐT: `Cancelled` không nằm trong partial
   * unique index `burial_records_active_slot`.
   */
  cancelledAt  DateTime? @map("cancelled_at") @db.Timestamptz(6)
  cancelReason String?   @map("cancel_reason")
  version        Int       @default(0)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  deceased DeceasedPerson @relation(fields: [deceasedPersonId], references: [id])

  @@index([gravePlotId, status])
  @@index([deceasedPersonId])
  @@map("burial_records")
  @@schema("cemetery")
}

/**
 * Nhật ký cấp thẻ quản lý mộ.
 * Số lần cấp là DỮ LIỆU IN TRÊN THẺ ("Lần cấp: 02"), nên nó phải đến từ một bản ghi bền
 * vững chứ không phải biến đếm ở giao diện.
 * Hệ cũ ghi dòng này TRƯỚC khi mở hộp thoại in, nên khách bấm Hủy là số vẫn nhảy. Ở đây
 * tách hẳn hai việc: XEM TRƯỚC không ghi gì, chỉ endpoint CẤP THẺ mới sinh dòng; in lại
 * một thẻ đã cấp thì đọc đúng dòng cũ, không sinh số mới.
 * CỐ Ý KHÔNG chụp lại nội dung thẻ vào đây. Hai lý do: (1) chụp lại nghĩa là ghi CCCD ra
 * một cột Json không mã hoá, đi vòng qua đúng cơ chế `national_id_cipher` dựng ra để
 * tránh; (2) chính điều 3 in trên thẻ đã nói khách đổi thông tin thì phải nộp thẻ để cấp
 * đổi — nên thẻ luôn phản ánh dữ liệu HIỆN TẠI là đúng nghiệp vụ, không phải thiếu sót.
 */
model CardPrintLog {
  id            String   @id
  companyId     String   @map("company_id")
  customerId    String   @map("customer_id")
  printNumber   Int      @map("print_number")
  cardType      String   @default("GRAVE") @map("card_type")
  printReason   String?  @map("print_reason")
  /// Tên và chức danh người ký, in ở ô chữ ký bên phải mặt bìa trước.
  approvedBy    String?  @map("approved_by")
  approvedTitle String?  @map("approved_title")
  issuedBy      String?  @map("issued_by")
  issuedAt      DateTime @default(now()) @map("issued_at") @db.Timestamptz(6)

  /// Chặn hai người cùng cấp ra "lần 02" cho một khách — số in trên giấy phải là duy nhất.
  @@unique([customerId, cardType, printNumber])
  @@index([customerId, issuedAt])
  @@map("card_print_logs")
  @@schema("cemetery")
}

/**
 * Biểu phí cấp thẻ mộ — anh Bách chốt 02/09/2026:
 *   cấp giấy LẦN ĐẦU 200.000đ phẳng (không nhân với gì)
 *   mỗi lần IN LẠI  50.000đ × SỐ CỐT CỦA PHẦN MỘ
 *
 * Hai mức giá này là CHÍNH SÁCH, không phải hằng số kỹ thuật — chúng sẽ đổi. Nên chúng
 * không nằm trong mã và cũng không nằm trong một cột "giá hiện tại" sửa đè được: mỗi lần
 * đổi giá là một DÒNG MỚI có `effectiveFrom`. Bảng append-only (trigger chặn UPDATE/DELETE),
 * đúng nếp copy-based: đổi = bản mới, không sửa bản gốc.
 *
 * CỐ Ý KHÔNG có `effectiveTo`. Đóng hiệu lực bằng `UPDATE` thì trigger chặn — nên "biểu phí
 * đang hiệu lực" được định nghĩa là dòng có `effectiveFrom <= ngày cấp` LỚN NHẤT. Hệ quả:
 * không dùng được `inEffect()` ở `common/lifecycle/active.ts` (hàm đó đòi cặp from/to);
 * phép chọn viết ở đúng một chỗ, `CardFeesService.effectiveSchedule`.
 *
 * `effectiveFrom` là @db.Date chứ không Timestamptz: biểu phí có hiệu lực theo NGÀY, và
 * giữ giờ trong đó là mời gọi lệch múi giờ quyết định hôm nay thu giá cũ hay giá mới.
 */
/**
 * NGƯỜI KÝ THẺ MỘ — danh mục TOÀN HỆ, KHÔNG chia theo công ty (anh Bách chốt 03/09/2026).
 *
 * Đây là người của INDEVCO ký ở ô BÊN PHẢI tờ thẻ, dưới dòng "INDEVCO - XN AN LẠC VIÊN".
 * Ô bên trái là CHỦ MỘ và tên khách tự in từ hồ sơ — không nằm ở bảng này.
 *
 * KHÔNG append-only (khác `GraveCardFeeSchedule` ngay dưới): sửa một chức danh gõ sai phải
 * sửa được tại chỗ. Nhưng cũng KHÔNG xoá cứng — `status` chuyển sang `Retired`, vì thẻ đã
 * cấp năm ngoái vẫn phải đọc ra được tên người đã ký nó.
 *
 * `CardPrintLog` chép `approvedBy`/`approvedTitle` thành CHUỖI chứ không giữ khoá ngoại tới
 * đây — CỐ Ý. Tờ giấy khách đang cầm ghi tên gì thì nhật ký phải đọc ra đúng tên đó, kể cả
 * khi người ấy đổi chức danh hoặc rời công ty. Danh mục này chỉ để CHỌN, không phải để tra
 * ngược. Cùng lý do `plotCode` được chép vào dòng phí thay vì join lại mỗi lần đọc.
 */
model CardSigner {
  id String @id

  /// Tài khoản người ký và NGHĨA TRANG người đó phụ trách — anh Bách chốt 05/09/2026:
  /// "người ký là người quản lý nghĩa trang". ĐẢO CÓ Ý THỨC quyết định 03/09 (danh mục toàn hệ).
  ///
  /// Cột trần, KHÔNG `@relation` sang `iam.users` — cùng nếp `RoleAssignment`, vốn ghi rõ
  /// "No FK to iam.users". NULLABLE vì dòng cũ (nhập tay, không nối tài khoản) phải ở lại
  /// được; tính bắt buộc nằm ở CHECK `card_signers_active_needs_user_site`, chỉ đòi ở dòng
  /// đang dùng.
  ///
  /// Luật "người này phải đang giữ vai QL_NGHIA_TRANG ở CHÍNH nghĩa trang này" KHÔNG viết
  /// được thành ràng buộc CSDL: hai schema khác nhau, và vai đổi theo thời gian nên một
  /// dòng hợp lệ hôm nay có thể hết hợp lệ ngày mai mà không ai UPDATE nó. Ép ở
  /// `CardSignersService` lúc ghi, và kiểm LẠI lúc đọc — người mất vai vẫn hiện ra kèm lý do
  /// chứ không lặng lẽ biến mất.
  userId     String? @map("user_id")
  cemeteryId String? @map("cemetery_id")

  /// Hai thứ IN LÊN tờ thẻ. Chép từ tài khoản lúc tạo (không ai gõ tay nữa), nhưng ở lại
  /// đây chứ không join mỗi lần đọc: tờ giấy khách cầm ghi gì thì dòng này phải giữ đúng cái
  /// đó, kể cả khi người ấy sau này đổi chức danh.
  fullName String @map("full_name")
  title    String

  /// Người được chọn sẵn ở màn hình cấp thẻ. Nhiều nhất MỘT dòng MỖI NGHĨA TRANG — ép bằng
  /// partial unique index, không bằng quy ước ở service. Một người phụ trách hai nghĩa trang
  /// thì có hai dòng và cả hai đều là mặc định: hợp lệ, vì tính duy nhất đo theo nghĩa trang.
  isDefault Boolean @default(false) @map("is_default")

  /// Active | Retired. NGỪNG DÙNG chứ không xoá.
  status String @default("Active")

  createdBy String?  @map("created_by")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([status])
  @@index([cemeteryId])
  @@map("card_signers")
  @@schema("cemetery")
}

model GraveCardFeeSchedule {
  id        String @id
  companyId String @map("company_id")
  cardType  String @default("GRAVE") @map("card_type")

  /// Tiền cấp giấy lần đầu — PHẲNG, không nhân với số cốt.
  firstIssueFee Decimal @map("first_issue_fee") @db.Decimal(14, 0) // VND
  /// Đơn giá MỘT cốt cho mỗi lần in lại.
  reprintFeePerRemains Decimal @map("reprint_fee_per_remains") @db.Decimal(14, 0) // VND

  effectiveFrom DateTime @map("effective_from") @db.Date
  /// Số quyết định / văn bản hiệu lực làm căn cứ. Không có căn cứ thì không ban hành giá.
  decisionRef String?  @map("decision_ref")
  createdBy   String?  @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  /// Một công ty không ban hành hai biểu phí cùng ngày hiệu lực — nếu không thì "biểu phí
  /// đang hiệu lực" là câu hỏi có hai câu trả lời.
  @@unique([companyId, cardType, effectiveFrom])
  @@index([companyId, effectiveFrom])
  @@map("grave_card_fee_schedules")
  @@schema("cemetery")
}

/**
 * Khoản phí của MỘT phần mộ trong MỘT lần cấp thẻ.
 *
 * Một dòng cho mỗi phần mộ, không phải một dòng cho mỗi lần cấp: thẻ mộ gom TOÀN BỘ phần
 * mộ mà khách đứng tên, nên một lần cấp có thể vừa là "lần đầu" với mộ mới mua vừa là
 * "in lại" với mộ đã có thẻ. Gộp thành một số tiền thì không ai truy được vì sao ra số đó.
 *
 * `unitPrice`, `remainsCount`, `feeAmount` là ẢNH CHỤP, cố ý ghi lặp lại dù suy ra được:
 * đơn giá sẽ đổi, số cốt của mộ sẽ sửa. Tính lại về sau nghĩa là tờ thẻ khách đang cầm và
 * con số trong hệ có ngày không khớp — và lúc đó khách đúng, hệ sai.
 *
 * Miễn phí ghi ĐỦ số tiền kèm `waived = true`, KHÔNG ghi 0đ. Ghi 0 thì không phân biệt
 * được "đã tha một khoản 150.000đ" với "biểu phí bằng 0", và câu kế toán sẽ hỏi — tháng
 * này tha bao nhiêu, ai tha — không còn dữ liệu để trả lời.
 *
 * Cũng append-only. Nghĩa là quyết định miễn phí phải xong TRƯỚC khi bấm cấp thẻ; sửa sai
 * là ghi dòng mới, và đường đó chưa dựng ở đợt này.
 */
model GraveCardFeeCharge {
  id        String @id
  companyId String @map("company_id")

  /// Cột trần, không @relation — cùng nếp `CardPrintLog` vốn không khai quan hệ nào.
  cardPrintLogId String @map("card_print_log_id")
  customerId     String @map("customer_id")
  /// Chiều PHẦN MỘ mà `CardPrintLog` không có. Đây là chỗ neo "lần đầu của cặp (khách, mộ)".
  gravePlotId String @map("grave_plot_id")

  /// FIRST_ISSUE | REPRINT — CHECK ở migration.
  feeKind       String @map("fee_kind")
  feeScheduleId String @map("fee_schedule_id")

  unitPrice    Decimal @map("unit_price") @db.Decimal(14, 0)
  /// 1 với FIRST_ISSUE (giá phẳng); = số cốt của phần mộ với REPRINT.
  remainsCount Int     @map("remains_count")
  feeAmount    Decimal @map("fee_amount") @db.Decimal(14, 0)

  waived Boolean @default(false)
  /// COMPANY_FAULT | OLD_CARD_RETURNED — danh sách đóng, CHECK ở migration. Không phải
  /// chuỗi tự do: đọc lý do miễn từ ô người dùng tự gõ là mở đường gõ chữ để khỏi mất tiền.
  waiveReason String? @map("waive_reason")

  chargedBy String?  @map("charged_by")
  chargedAt DateTime @default(now()) @map("charged_at") @db.Timestamptz(6)

  /// Luật "một cặp (khách, mộ) chỉ có ĐÚNG MỘT lần đầu" ép bằng partial unique index viết
  /// tay ở migration (`grave_card_fee_charges_first_issue`) — Prisma không diễn đạt được
  /// unique có điều kiện. Đây là chỗ DUY NHẤT ép được luật đó; đừng suy từ `printNumber == 1`.
  @@index([cardPrintLogId])
  @@index([customerId, gravePlotId])
  @@index([companyId, chargedAt])
  @@map("grave_card_fee_charges")
  @@schema("cemetery")
}

// M5: grave-care services. A5 = no A/R: each subscription/renewal is paid in full at
// creation and recorded as a service_transaction (= revenue).
model ServiceCatalog {
  id             String   @id
  companyId      String   @map("company_id")
  code           String
  name           String
  price          Decimal  @db.Decimal(14, 0) // VND
  durationMonths Int      @map("duration_months")
  reminderDays   Int[]    @map("reminder_days") // e.g. [90,60,30,7]
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  subscriptions ServiceSubscription[]

  @@unique([companyId, code])
  @@map("service_catalog")
  @@schema("services")
}

model ServiceSubscription {
  id                     String   @id
  companyId              String   @map("company_id")
  gravePlotId            String   @map("grave_plot_id")
  contractId             String?  @map("contract_id")
  serviceCatalogId       String   @map("service_catalog_id")
  customerId             String   @map("customer_id")
  agreedPrice            Decimal  @map("agreed_price") @db.Decimal(14, 0)
  effectiveFrom          DateTime @map("effective_from") @db.Date
  effectiveTo            DateTime @map("effective_to") @db.Date
  status                 String   @default("Active") // Active | Expired | Renewed | Cancelled
  previousSubscriptionId String?  @map("previous_subscription_id")
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  catalog      ServiceCatalog       @relation(fields: [serviceCatalogId], references: [id])
  transactions ServiceTransaction[]

  @@index([gravePlotId])
  @@index([status, effectiveTo])
  @@map("service_subscriptions")
  @@schema("services")
}

// Paid-in-full revenue record (A5). Immutable — corrections are new rows, never edits.
model ServiceTransaction {
  id               String   @id
  subscriptionId   String   @map("subscription_id")
  companyId        String   @map("company_id")
  serviceCatalogId String   @map("service_catalog_id")
  customerId       String   @map("customer_id")
  amount           Decimal  @db.Decimal(14, 0)
  paidAt           DateTime @default(now()) @map("paid_at") @db.Timestamptz(6)
  periodFrom       DateTime @map("period_from") @db.Date
  periodTo         DateTime @map("period_to") @db.Date
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  subscription ServiceSubscription @relation(fields: [subscriptionId], references: [id])

  @@index([companyId, paidAt])
  @@index([serviceCatalogId])
  @@map("service_transactions")
  @@schema("services")
}
