# Application
APP_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:4000

# Database (matches docker-compose defaults)
POSTGRES_USER=erp
POSTGRES_PASSWORD=erp
POSTGRES_DB=erp
DATABASE_URL=postgresql://erp:erp@localhost:5432/erp?schema=public

# Queue / cache
REDIS_URL=redis://localhost:6379

# Object storage (S3-compatible / MinIO)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=erp-files
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# Authentication and encryption (fill with strong secrets; never commit real values)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ENCRYPTION_KEY=

# Email (Mailpit in dev)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=

# Operations
VIRUS_SCAN_ENABLED=false
AUDIT_RETENTION_DAYS=3650
FILE_MAX_SIZE_MB=25
