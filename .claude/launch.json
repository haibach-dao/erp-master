{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "--watch-path=./src",
        "--watch-preserve-output",
        "-r",
        "@swc-node/register",
        "src/main.ts"
      ],
      "port": 4000,
      "cwd": "apps/api"
    },
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@erp/web",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "web-3100",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "next",
        "dev",
        "-p",
        "3100"
      ],
      "port": 3100,
      "cwd": "apps/web",
      "env": {
        "NEXT_DIST_DIR": ".next-3100"
      }
    },
    {
      "name": "ma-tran-quyen",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        ".local/serve.js"
      ],
      "port": 4321
    }
  ]
}
